{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests"
  ],
  "timezone": "Europe/Madrid",
  "addLabels": [
    "dependencies"
  ],
  "minimumReleaseAge": "14 days",
  "internalChecksFilter": "strict",
  "ignorePresets": [":ignoreModulesAndTests"],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["**/CMakeLists.txt"],
      "matchStrings": ["vitrio_fetch_boost\\(\\s*TAG (?<currentValue>\\S+)\\s+SHA256 (?<currentDigest>[0-9a-f]{64})"],
      "depNameTemplate": "boost",
      "packageNameTemplate": "boostorg/boost",
      "datasourceTemplate": "github-release-attachments",
      "versioningTemplate": "regex:^boost-(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)$"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["**/CMakeLists.txt"],
      "matchStrings": ["vitrio_fetch_spdlog\\(\\s*COMMIT (?<currentDigest>[0-9a-f]{40})\\s*\\) # (?<currentValue>\\S+)"],
      "depNameTemplate": "spdlog",
      "packageNameTemplate": "gabime/spdlog",
      "datasourceTemplate": "github-tags"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["**/CMakeLists.txt"],
      "matchStrings": ["vitrio_fetch_zlib\\(\\s*COMMIT (?<currentDigest>[0-9a-f]{40})\\s*\\) # (?<currentValue>\\S+)"],
      "depNameTemplate": "zlib",
      "packageNameTemplate": "madler/zlib",
      "datasourceTemplate": "github-tags"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["**/CMakeLists.txt"],
      "matchStrings": ["vitrio_fetch_tiff\\(\\s*COMMIT (?<currentDigest>[0-9a-f]{40})\\s*\\) # (?<currentValue>\\S+)"],
      "depNameTemplate": "libtiff",
      "packageNameTemplate": "libtiff/libtiff",
      "datasourceTemplate": "gitlab-tags"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["**/CMakeLists.txt"],
      "matchStrings": ["vitrio_fetch_catch2\\(\\s*COMMIT (?<currentDigest>[0-9a-f]{40})\\s*\\) # (?<currentValue>\\S+)"],
      "depNameTemplate": "catch2",
      "packageNameTemplate": "catchorg/Catch2",
      "datasourceTemplate": "github-tags"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["**/CMakeLists.txt"],
      "matchStrings": ["vitrio_fetch_google_benchmark\\(\\s*COMMIT (?<currentDigest>[0-9a-f]{40})\\s*\\) # (?<currentValue>\\S+)"],
      "depNameTemplate": "google-benchmark",
      "packageNameTemplate": "google/benchmark",
      "datasourceTemplate": "github-tags"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["**/CMakeLists.txt"],
      "matchStrings": ["vitrio_fetch_trompeloeil\\(\\s*COMMIT (?<currentDigest>[0-9a-f]{40})\\s*\\) # (?<currentValue>\\S+)"],
      "depNameTemplate": "trompeloeil",
      "packageNameTemplate": "rollbear/trompeloeil",
      "datasourceTemplate": "github-tags"
    }
  ]
}
